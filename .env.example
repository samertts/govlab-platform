# Core runtime
NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/govlab
SESSION_SECRET=change-me-to-a-long-random-value
NATIONAL_ID_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Allow trusted external UI/API origins for GULA platform integration
# Comma-separated list of exact origins (scheme + host + optional port)
# Example: https://gula.example.gov,https://admin.gula.example.gov
GULA_TRUSTED_ORIGINS=
